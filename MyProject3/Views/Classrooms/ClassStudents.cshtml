@model MyProject3.Models.Classroom

@{
    ViewData["Title"] = "ClassStudents";
}

<h1>פרטי כיתה ותלמידים</h1>

<div>
    <h4>פרטים</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            שם הכיתה
        </dt>
        <dd class="col-sm-10">
            @Model.ClassName
        </dd>
    </dl>
</div>
<hr />
<h4>תלמידים בכיתה זו</h4>
@if (Model.Students != null && Model.Students.Any())
{
    <table class="table">
        <thead>
            <tr>
                <th>שם פרטי</th>
                <th>שם משפחה</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Students)
            {
                <tr>
                    <td>
                        שם פרטי:
                    </td>
                    <td>
                        שם משפחה:
                    </td>
                    <td>
                        <a asp-controller="Students" asp-action="Details" asp-route-id="@item.Id">פרטים</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>אין עדיין תלמידים רשומים לכיתה זו.</p>
}
</div>

<div>
    <a asp-action="Edit" asp-route-id="@Model?.Id">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
