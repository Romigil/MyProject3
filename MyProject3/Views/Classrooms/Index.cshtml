@model IEnumerable<MyProject3.Models.Classroom>

@{
    ViewData["Title"] = "Index";
}

<h1>רשימת כיתות</h1>

<p>
    <a asp-action="Create">הוספת כיתה חדשה</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                הכיתות שיש:
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.ClassName)
            </td>
            <td>
                    <a asp-action="Edit" asp-route-id="@item.Id">עריכה</a> |
                    <a asp-action="Details" asp-route-id="@item.Id">פרטים</a> |
                    <a asp-action="Delete" asp-route-id="@item.Id">מחיקה</a> |
                    <a asp-action="ClassStudents" asp-route-id="@item.Id">תלמידים בכיתה</a>
            </td>
        </tr>
}
    </tbody>
</table>
