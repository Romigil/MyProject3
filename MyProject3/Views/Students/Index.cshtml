@model IEnumerable<MyProject3.Models.Student>

@{
    ViewData["Title"] = "Index";
}

<h1>רשימות תלמידים</h1>

<p>
    <a asp-action="Create">הוספת תלמיד חדש</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                שם פרטי
            </th>
            <th>
                שם משפחה
            </th>
            <th>
                כיתה
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.FirstName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.LastName)
            </td>
            <td>
                    @Html.DisplayFor(modelItem => item.Classroom.ClassName)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">עריכה</a> |
                <a asp-action="Details" asp-route-id="@item.Id">פרטים</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">מחיקה</a>
            </td>
        </tr>
}
    </tbody>
</table>
